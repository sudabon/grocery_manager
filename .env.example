# 環境固有の値。このファイルを .env にコピーして記入する（.env は git 管理外）。
# シェルに読み込む:
#   set -a; . ./.env; set +a

# AWS CLI / Terraform が使うプロファイルとリージョン
AWS_PROFILE=
AWS_REGION=ap-northeast-1

# tfstate を置く S3 バケット名（S3 の名前空間はグローバルに一意）。
# 初回のみ次の形で Terraform へ渡す:
#   terraform -chdir=infra init -backend-config="bucket=$QUADMEMO_TFSTATE_BUCKET"
QUADMEMO_TFSTATE_BUCKET=

# 配信用サブドメインの FQDN（例: app.example.com）。
# TF_VAR_ 接頭辞により Terraform の var.domain_name に渡るため、
# infra/terraform.tfvars を別途用意する必要はない。
TF_VAR_domain_name=

# 配信先の明示指定（任意）。両方を指定すると scripts/deploy.sh は terraform output を
# 参照せず、この値へ同期・無効化する（片方だけなら欠けている側を terraform output で補う）。
# 値は terraform -chdir=infra output -raw app_bucket / cloudfront_distribution_id で得られる。
# CD（.github/workflows/deploy.yml）では GitHub Environment `production` の variable から渡る。
QUADMEMO_APP_BUCKET=
QUADMEMO_DISTRIBUTION_ID=

# 配信 E2E の対象。TF_VAR_domain_name と同じホストを https:// で指定する。
E2E_BASE_URL=
